/* Horizontal row: do not use dock:* on these children — dock removes them from
   the layout flow and the preview pane was consuming the full width alone. */
#browser {
  layout: horizontal;
  height: 1fr;
  width: 100%;
}

#dirs-parent {
  width: 1fr;
  min-width: 18;
  height: 1fr;
}

#dirs-current {
  width: 1fr;
  min-width: 18;
  height: 1fr;
}

OptionList {
  height: 1fr;
  min-height: 5;
}

#content {
  width: 2fr;
  min-width: 28;
  height: 1fr;
  border: tall $primary;
  background: $boost;
  padding: 0 1;
}

/* Full-width dataset / plot / table: hide browser columns (toggle with l). */
.preview-maximized #dirs-parent,
.preview-maximized #dirs-current {
  display: none;
}

.preview-maximized #content {
  width: 1fr;
  min-width: 0;
}

#data {
  width: 100%;
}

#plot {
  dock: top;
  display: none;
}

#dtable {
  dock: top;
  display: none;
}

.view-dataset #data {
  display: block;
}
.view-dataset #dtable {
  display: none;
}

.view-plot #data {
  display: none;
}
.view-plot #plot {
  display: block;
}
.view-plot #dtable {
  display: none;
}

.view-dtable #data {
  display: none;
}
.view-dtable #plot {
  display: none;
}
.view-dtable #dtable {
  display: block;
}

#header {
  background: $boost;
  border: tall $success;
  padding: 0 1;
  margin: 1 0;
}

Toast {
  padding: 1;
  margin: 0;
}

AttributeScreen {
  align: center middle;
}
#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 80%;
    height: 80%;
    border: thick $background 80%;
    background: $surface;
}
#attr_title {
    column-span: 2;
    height: 10%;
    width: 1fr;
    content-align: center middle;
}
.attr_col {
    column-span: 1;
    height: 1fr;
    width: 1fr;
}
#attr_content_scroll {
  margin: 1 0;
}
#attr_content {
  border: tall $secondary;
  background: $panel;
  margin: 0 0;
  padding: 0 1;
}
