/* Horizontal row: do not use dock:* on #content — dock removes it from layout flow. */
#browser {
  layout: horizontal;
  height: 1fr;
  width: 100%;
  /* Outer frame: same hairline as inner column rules */
  border-left: solid $foreground 12%;
  border-right: solid $foreground 12%;
}

/* Uniform vertical rules. Columns use no fill (window background shows); row
   selection keeps default block-cursor styling. OptionList defaults to padding 0 1,
   which insets highlights from the rules — force zero on widget and options. */
OptionList#dirs-parent,
OptionList#dirs-current {
  width: 1fr;
  min-width: 18;
  height: 1fr;
  border: none;
  border-right: solid $foreground 12%;
  background: transparent;
  padding: 0;
}

OptionList#dirs-parent:focus,
OptionList#dirs-current:focus {
  border: none;
  border-right: solid $foreground 12%;
  background-tint: transparent;
}

OptionList#dirs-parent .option-list--option,
OptionList#dirs-current .option-list--option {
  padding: 0;
}

/* Only our OptionLists — not Textual's SelectOverlay (subclass of OptionList),
   which must keep height: auto + overlay: screen for a real dropdown. */
MyOptionList {
  height: 1fr;
  min-height: 5;
}

#content {
  width: 2fr;
  min-width: 28;
  height: 1fr;
  border: none;
  background: $boost;
  padding: 0;
}

#content #data {
  padding: 0 1;
}

/* Empty HDF5 group: horizontal center, top-aligned vertically */
#content.empty-group-preview #data {
  height: 1fr;
  content-align: center top;
}

/* Full-width dataset / plot / table */
.preview-maximized #dirs-parent,
.preview-maximized #dirs-current {
  display: none;
}

.preview-maximized #content {
  width: 1fr;
  min-width: 0;
}

#data {
  width: 100%;
}

#plot {
  dock: top;
  display: none;
}

#dtable {
  dock: top;
  display: none;
}

.view-dataset #data {
  display: block;
}
.view-dataset #dtable {
  display: none;
}

/* Table vs text: dtable replaces #data when view-dtable is set. */
.view-dtable #data {
  display: none;
}
.view-dtable #plot {
  display: none;
}
.view-dtable #dtable {
  display: block;
}

/* Browse sidebar: metadata (#data) stacked above snapshot DataTable (#dtable). */
#content.browse-preview-table {
  /* Do not vertically scroll the shell: it clips the DataTable, hiding row labels
     and slicing the last row. Scrolling is unnecessary for the small snapshot. */
  overflow-y: hidden;
}
#content.browse-preview-table #plot {
  display: none;
}
#content.browse-preview-table #data {
  display: block;
  height: auto;
  min-height: 0;
}
#content.browse-preview-table #dtable {
  display: block;
  dock: initial;
  height: auto;
  width: 100%;
}

/* Plot must come after .view-dtable so p toggles plot even when the dataset uses a DataTable. */
.view-plot #data {
  display: none;
}
.view-plot #plot {
  display: block;
}
.view-plot #dtable {
  display: none;
}

/* Path line: bold, no box */
#header {
  text-style: bold;
  background: transparent;
  border: none;
  padding: 0 1;
  margin: 0;
  width: 100%;
  height: auto;
}

Toast {
  padding: 1;
  margin: 0;
}

AttributeScreen,
DatasetSummaryScreen,
JumpToLineScreen {
  align: center middle;
}

/* Small filter box; bottom-right (see #group-find-dialog). */
GroupFindScreen {
  align: right bottom;
}

JumpToLineScreen #jump-line-dialog {
  width: 44%;
  max-width: 52;
  min-width: 32;
  height: auto;
  border: thick $foreground 38%;
  border-title-align: center;
  border-title-style: bold;
  border-title-color: $foreground 78%;
  background: $surface;
  padding: 1 2;
}

GroupFindScreen #group-find-dialog {
  width: 52;
  max-width: 52%;
  min-width: 30;
  height: auto;
  border: none;
  background: transparent;
  padding: 0;
  margin: 0 1 1 0;
  layout: vertical;
}

GroupFindScreen #group_find_input {
  width: 100%;
  height: 3;
  min-height: 3;
  margin: 0;
  border: tall $foreground 12%;
  background: $panel;
  border-title-align: left;
  border-title-style: bold;
  border-title-color: $foreground 82%;
}

GroupFindScreen #group_find_input:focus {
  border: tall $foreground 45%;
  background-tint: $foreground 6%;
  border-title-color: $foreground;
}

AttributeScreen MyOptionList {
  border-title-align: center;
}

/* Modal shells: identical outer size for attributes, summary, and save-plot. */
AttributeScreen #dialog,
DatasetSummaryScreen #summary_dialog,
SavePlotScreen #save-plot-dialog {
  width: 70%;
  max-width: 96;
  min-width: 68;
  height: 68%;
  max-height: 78%;
  border: thick $background 80%;
  background: $surface;
  padding: 1 2;
}

/* Same canvas as main preview (#content): summary table matches #dtable theme defaults. */
DatasetSummaryScreen #summary_dialog {
  background: $boost;
}

DatasetSummaryScreen #summary_modal_title {
  text-style: bold;
  content-align: center middle;
  margin: 0 0 1 0;
}

DatasetSummaryScreen #summary_datatable {
  height: 1fr;
  min-height: 8;
  width: 100%;
}

#dialog {
  grid-size: 2;
  grid-gutter: 1 2;
  grid-rows: 1fr 3;
}
#attr_title {
    column-span: 2;
    height: 10%;
    width: 1fr;
    content-align: center middle;
}
.attr_col {
    column-span: 1;
    height: 1fr;
    width: 1fr;
}
#attr_content_scroll {
  margin: 1 0;
}
#attr_content {
  border: tall $secondary;
  background: $panel;
  margin: 0 0;
  padding: 0 1;
}

SavePlotScreen {
  align: center middle;
}

/* Shell fills modal (``SavePlotScreen #save-plot-dialog`` height); inner scrolls when needed. */
#save-plot-dialog {
  align: left top;
  layout: vertical;
}

SavePlotScreen #save_plot_scroll {
  height: 1fr;
  min-height: 5;
}

#save-plot-dialog.mode-lineplot .hist-opts {
  display: none;
}

#save-plot-dialog.mode-histogram .line-opts {
  display: none;
}

/* Compound: line mode shows X/Y + log; histogram mode shows field + bins. */
#save-plot-dialog.mode-lineplot.compound-dataset .compound-hist-opts {
  display: none;
}

#save-plot-dialog.mode-histogram.compound-dataset .compound-xy-opts {
  display: none;
}

/* Browse compound histogram: field picker only (``histogram_settings_only``). */
#save-plot-dialog.histogram-settings-only .compound-hist-opts {
  padding: 0 1;
  width: 100%;
}

#save_plot_title {
  margin: 0 0 1 0;
  text-style: bold;
  content-align: center middle;
  width: 100%;
}

/* Border + title on ``Select``; ``SelectCurrent`` is flush inside (no double frame).
   Textual's default border_title_color is effectively invisible; without an explicit
   ``border-title-color``, titles pick up the dim border ($foreground 12%) and are unreadable. */
#save-plot-dialog Select {
  width: 100%;
  height: auto;
  min-height: 3;
  margin: 0 0 1 0;
  border: tall $foreground 12%;
  background: $panel;
  border-title-align: left;
  border-title-style: bold;
  border-title-color: $foreground 82%;
}

#save-plot-dialog Select > SelectCurrent {
  border: none;
  background: transparent;
}

#save-plot-dialog Select > SelectCurrent Static#label {
  content-align: center middle;
}

#save-plot-dialog Select:focus {
  border: tall $foreground 45%;
  background-tint: $foreground 6%;
  border-title-color: $foreground;
}

#save-plot-dialog Select:focus > SelectCurrent {
  border: none;
  background: transparent;
}

#save-plot-dialog .hist-opts,
#save-plot-dialog .line-opts {
  width: 100%;
  height: auto;
  min-height: 3;
  margin: 0 0 1 0;
  border: tall $foreground 12%;
  background: $panel;
  padding: 0 1;
  border-title-style: bold;
  border-title-color: $foreground 82%;
}

#save-plot-dialog .hist-opts:focus-within,
#save-plot-dialog .line-opts:focus-within {
  border: tall $foreground 45%;
  background-tint: $foreground 4%;
  border-title-color: $foreground;
}

#save-plot-dialog .line-opts Checkbox {
  width: 1fr;
  content-align: center middle;
}

/* Compound: Select + Log checkbox share one row per axis. */
#save-plot-dialog .compound-axis-row {
  width: 100%;
  height: auto;
  min-height: 3;
  margin: 0 0 1 0;
}

#save-plot-dialog .compound-axis-row Select {
  width: 1fr;
  min-height: 3;
  margin: 0 1 0 0;
}

#save-plot-dialog .compound-axis-row Checkbox {
  width: auto;
  content-align: center middle;
}

/* ToggleButton defaults use block-cursor colors on focus — unreadable on dark panels. */
#save-plot-dialog Checkbox:focus > .toggle--label {
  color: $foreground;
  background: transparent;
  text-style: none;
}

#save_bins {
  width: 100%;
  height: 3;
  min-height: 3;
}

#save_bins:focus {
  border: tall $foreground 45%;
  background-tint: $foreground 6%;
}

#save_filename {
  width: 100%;
  height: 3;
  min-height: 3;
  margin: 1 0 1 0;
  border: tall $foreground 12%;
  background: $panel;
  border-title-align: left;
  border-title-style: bold;
  border-title-color: $foreground 82%;
}

#save_filename:focus {
  border: tall $foreground 45%;
  background-tint: $foreground 6%;
  border-title-color: $foreground;
}

#save_plot_btn,
#confirm_plot_btn,
#confirm_hist_plot_btn {
  width: 100%;
  height: 3;
  min-height: 3;
  max-height: 3;
  margin: 0;
  border: tall $foreground 12%;
}

#save_plot_btn:focus,
#confirm_plot_btn:focus,
#confirm_hist_plot_btn:focus {
  border: tall $foreground 45%;
  background-tint: $foreground 8%;
}
