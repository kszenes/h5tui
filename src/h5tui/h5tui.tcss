/* Horizontal row: do not use dock:* on #content — dock removes it from layout flow. */
#browser {
  layout: horizontal;
  height: 1fr;
  width: 100%;
  /* Outer frame: same hairline as inner column rules */
  border-left: solid $foreground 12%;
  border-right: solid $foreground 12%;
}

/* Uniform vertical rules. Columns use no fill (window background shows); row
   selection keeps default block-cursor styling. OptionList defaults to padding 0 1,
   which insets highlights from the rules — force zero on widget and options. */
OptionList#dirs-parent,
OptionList#dirs-current {
  width: 1fr;
  min-width: 18;
  height: 1fr;
  border: none;
  border-right: solid $foreground 12%;
  background: transparent;
  padding: 0;
}

OptionList#dirs-parent:focus,
OptionList#dirs-current:focus {
  border: none;
  border-right: solid $foreground 12%;
  background-tint: transparent;
}

OptionList#dirs-parent .option-list--option,
OptionList#dirs-current .option-list--option {
  padding: 0;
}

OptionList {
  height: 1fr;
  min-height: 5;
}

#content {
  width: 2fr;
  min-width: 28;
  height: 1fr;
  border: none;
  background: $boost;
  padding: 0;
}

#content #data {
  padding: 0 1;
}

/* Full-width dataset / plot / table */
.preview-maximized #dirs-parent,
.preview-maximized #dirs-current {
  display: none;
}

.preview-maximized #content {
  width: 1fr;
  min-width: 0;
}

#data {
  width: 100%;
}

#plot {
  dock: top;
  display: none;
}

#dtable {
  dock: top;
  display: none;
}

.view-dataset #data {
  display: block;
}
.view-dataset #dtable {
  display: none;
}

.view-plot #data {
  display: none;
}
.view-plot #plot {
  display: block;
}
.view-plot #dtable {
  display: none;
}

.view-dtable #data {
  display: none;
}
.view-dtable #plot {
  display: none;
}
.view-dtable #dtable {
  display: block;
}

/* Path line: bold, no box */
#header {
  text-style: bold;
  background: transparent;
  border: none;
  padding: 0 1;
  margin: 0;
  width: 100%;
  height: auto;
}

Toast {
  padding: 1;
  margin: 0;
}

AttributeScreen {
  align: center middle;
}
#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 80%;
    height: 80%;
    border: thick $background 80%;
    background: $surface;
}
#attr_title {
    column-span: 2;
    height: 10%;
    width: 1fr;
    content-align: center middle;
}
.attr_col {
    column-span: 1;
    height: 1fr;
    width: 1fr;
}
#attr_content_scroll {
  margin: 1 0;
}
#attr_content {
  border: tall $secondary;
  background: $panel;
  margin: 0 0;
  padding: 0 1;
}
